@model HeThongDatLichVaKhamBenh.Models.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng ký tài khoản";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ thống đặt lịch và hỗ trợ khám bệnh</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .auth-form-container {
            overflow-y: auto;
            max-height: 100vh;
        }
        .register-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0 16px;
        }
        .full-width {
            grid-column: 1 / -1;
        }
        @@media (max-width: 768px) {
            .register-form-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body class="modern-auth-page">
    <div class="auth-layout">
        <div class="auth-visual">
            <div class="visual-content">
                <div class="d-flex align-items-end mb-4">
                    <div class="brand-logo mb-0 me-4">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                        </svg>
                    </div>
                    <img src="~/images/br.png" alt="Doctor" class="auth-doctor-img" />
                </div>
                <h1 class="visual-title">Hệ thống đặt lịch &<br/>Hỗ trợ khám bệnh</h1>
                <p class="visual-subtitle">Chăm sóc sức khỏe thông minh, tiện lợi và tận tâm.</p>
            </div>
            <div class="visual-decoration">
                <div class="deco-circle deco-1"></div>
                <div class="deco-circle deco-2"></div>
                <div class="glass-card animate-float">
                    <div class="glass-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
                    </div>
                    <div class="glass-text">
                        <span>Đăng ký dễ dàng</span>
                        <small>Hồ sơ lưu trữ bảo mật</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="auth-form-container">
            <div class="auth-form-wrapper animate-fade-in-up" style="max-width: 600px; padding: 2rem 0;">
                <div class="form-header">
                    <h2>Tạo tài khoản mới</h2>
                    <p>Điền thông tin để bắt đầu sử dụng dịch vụ</p>
                </div>

                <form asp-action="Register" method="post" class="modern-login-form">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 alert alert-danger rounded-3 border-0 bg-danger bg-opacity-10 px-3 py-2"></div>

                    <h6 class="text-muted fw-bold mb-3 mt-4 small text-uppercase" style="letter-spacing: 0.5px;">1. Thông tin đăng nhập</h6>
                    <div class="register-form-grid">
                        <div class="form-floating mb-3 full-width">
                            <input asp-for="TenDangNhap" class="form-control" placeholder=" " autocomplete="username" />
                            <label asp-for="TenDangNhap">Tên đăng nhập</label>
                            <span asp-validation-for="TenDangNhap" class="text-danger small mt-1 d-block ms-1"></span>
                        </div>

                        <div class="form-floating mb-3 position-relative">
                            <input asp-for="MatKhau" class="form-control pe-5" placeholder=" " autocomplete="new-password" id="MatKhau" />
                            <label asp-for="MatKhau">Mật khẩu</label>
                            <span asp-validation-for="MatKhau" class="text-danger small mt-1 d-block ms-1"></span>
                        </div>

                        <div class="form-floating mb-3 position-relative">
                            <input asp-for="XacNhanMatKhau" class="form-control pe-5" placeholder=" " autocomplete="new-password" />
                            <label asp-for="XacNhanMatKhau">Xác nhận mật khẩu</label>
                            <span asp-validation-for="XacNhanMatKhau" class="text-danger small mt-1 d-block ms-1"></span>
                        </div>
                        
                        <div class="form-floating mb-3 full-width">
                            <input asp-for="Email" class="form-control" placeholder=" " autocomplete="email" />
                            <label asp-for="Email">Email liên hệ</label>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block ms-1"></span>
                        </div>
                    </div>

                    <h6 class="text-muted fw-bold mb-3 mt-4 small text-uppercase" style="letter-spacing: 0.5px;">2. Thông tin hồ sơ y tế</h6>
                    <div class="register-form-grid">
                        <div class="form-floating mb-3 full-width">
                            <input asp-for="HoTen" class="form-control" placeholder=" " />
                            <label asp-for="HoTen">Họ và tên (như CMND/CCCD)</label>
                            <span asp-validation-for="HoTen" class="text-danger small mt-1 d-block ms-1"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <select asp-for="GioiTinh" class="form-select">
                                <option value="">Chọn giới tính</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                            </select>
                            <label asp-for="GioiTinh">Giới tính</label>
                            <span asp-validation-for="GioiTinh" class="text-danger small mt-1 d-block ms-1"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="NgaySinh" type="date" class="form-control" placeholder=" " min="@DateTime.Now.AddYears(-120).ToString("yyyy-MM-dd")" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <label asp-for="NgaySinh">Ngày sinh</label>
                            <span asp-validation-for="NgaySinh" class="text-danger small mt-1 d-block ms-1"></span>
                        </div>

                        <div class="form-floating mb-3 full-width">
                            <input asp-for="DienThoai" class="form-control" placeholder=" " />
                            <label asp-for="DienThoai">Số điện thoại (10 số)</label>
                            <span asp-validation-for="DienThoai" class="text-danger small mt-1 d-block ms-1"></span>
                        </div>

                        <div class="form-floating mb-4 full-width">
                            <input asp-for="DiaChi" class="form-control" placeholder=" " />
                            <label asp-for="DiaChi">Địa chỉ liên hệ</label>
                            <span asp-validation-for="DiaChi" class="text-danger small mt-1 d-block ms-1"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn-modern-login w-100 mt-2">Đăng ký tài khoản</button>
                </form>

                <p class="auth-register-text mt-5 text-center text-secondary">
                    Đã có tài khoản? <a asp-action="Login" class="text-decoration-none fw-semibold">Đăng nhập ngay</a>
                </p>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
